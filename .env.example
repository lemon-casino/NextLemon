# MuAPI real-service verification
# Copy this file to .env.local and fill the values before running:
# npm run verify:muapi:env -- --json --require-real --require-chat
# npm run verify:muapi -- --json --require-chat --report releases\muapi-real-verification-report.json
# npm run verify:muapi:assert-real -- --json --report releases\muapi-real-verification-report.json

MUAPI_BASE_URL=https://api.muapi.ai
MUAPI_API_KEY=
MUAPI_MODEL=gpt-4o

# Required for strict release. Leave empty only when doing non-strict, account/session-only smoke checks.
MUAPI_CHAT_PROBE=

# Strict release should keep this as 1 so chat + job events are required.
MUAPI_REQUIRE_CHAT=1

# Writes JSON verification output to this path.
MUAPI_VERIFY_REPORT=muapi-verification-report.json

# Writes non-network MuAPI environment preflight output to this path.
MUAPI_ENV_REPORT=muapi-env-report.json
